generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LensMode {
  predefined
  custom
}

enum IndexState {
  PENDING
  INDEXING
  READY
  FAILED
}

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  passwordHash        String?
  emailVerified       Boolean         @default(false)
  role                String          @default("user")
  failedLoginAttempts Int             @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime        @default(now())
  sessions            Session[]
  oauthAccounts       OAuthAccount[]
  mfaSecret           String?
  mfaEnabled          Boolean         @default(false)
  tokens              Token[]
  searchHistory       SearchHistory[]
  lenses              Lens[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revoked      Boolean  @default(false)
}

model AuthEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  provider       String
  providerUserId String
  email          String?
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
}

model Token {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  type      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RateLimitEntry {
  key     String   @id
  count   Int
  resetAt DateTime
}

model OAuthState {
  state      String   @id
  linkUserId String?
  expiresAt  DateTime
}

model Document {
  id                String     @id @default(cuid())
  canonicalUrl      String     @unique
  domain            String
  title             String?
  description       String?
  publishedAt       DateTime?
  cleanText         String
  contentHash       String     @unique
  simhash           String?
  nearDuplicateOfId String?
  nearDuplicateOf   Document?  @relation("DocumentDuplicates", fields: [nearDuplicateOfId], references: [id])
  duplicates        Document[] @relation("DocumentDuplicates")
  crawledAt         DateTime   @default(now())
  lensTags          String[]
  searchVector      Unsupported("tsvector")? @map("search_vector")

  @@map("documents")
  @@index([domain])
  @@index([crawledAt])
}

model RawFetch {
  id         String   @id @default(cuid())
  url        String
  domain     String
  statusCode Int?
  headers    Json?
  rawHtml    String?
  fetchedAt  DateTime @default(now())
  extracted  Boolean  @default(false)

  @@map("raw_fetches")
}

model Lens {
  id            String          @id @default(cuid())
  slug          String?         @unique
  name          String
  description   String?
  mode          LensMode
  owner         String?
  user          User?           @relation(fields: [owner], references: [id], onDelete: Cascade)
  domains       String[]
  tags          String[]
  seeds         LensSeed[]
  indexState    IndexState      @default(PENDING)
  lastIndexedAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  searchHistory SearchHistory[]

  @@index([owner])
  @@map("lenses")
}

model LensSeed {
  id       String @id @default(cuid())
  lensId   String
  lens     Lens   @relation(fields: [lensId], references: [id], onDelete: Cascade)
  url      String
  maxDepth Int    @default(2)
  maxPages Int    @default(200)

  @@unique([lensId, url])
  @@map("lens_seeds")
}

model SearchHistory {
  id          String   @id @default(cuid())
  query       String
  lensId      String?
  lens        Lens?    @relation(fields: [lensId], references: [id], onDelete: SetNull)
  filters     Json?
  resultCount Int?
  createdAt   DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  @@map("search_history")
}